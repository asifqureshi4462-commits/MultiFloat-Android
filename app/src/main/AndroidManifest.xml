<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Overlay & Service Permissions -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Connectivity for Browser, AI Assistant, and Translator -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Camera for QR Scanner & Flashlight -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".MultiFloatApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MultiFloat"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.MultiFloat.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.OnboardingActivity" android:exported="false" />
        <activity android:name=".ui.PermissionSetupActivity" android:exported="false" />
        <activity android:name=".ui.MainActivity" android:exported="false" android:launchMode="singleTop" />
        <activity android:name=".ui.FloatingToolsMenuActivity" android:exported="false" />
        <activity android:name=".ui.WindowManagerActivity" android:exported="false" />

        <!-- Mini-App Dedicated Screens -->
        <activity android:name=".ui.tools.CalculatorActivity" android:exported="false" />
        <activity android:name=".ui.tools.NotesActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.tools.BrowserActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.tools.AiAssistantActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.tools.ClipboardActivity" android:exported="false" />
        <activity android:name=".ui.tools.QrScannerActivity" android:exported="false" />
        <activity android:name=".ui.tools.StopwatchTimerActivity" android:exported="false" />
        <activity android:name=".ui.tools.TodoActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.tools.TextEditorActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.tools.ClockActivity" android:exported="false" />
        <activity android:name=".ui.tools.TranslatorActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.tools.MusicControlsActivity" android:exported="false" />

        <!-- Settings & Info Screens -->
        <activity android:name=".ui.settings.SidebarSettingsActivity" android:exported="false" />
        <activity android:name=".ui.settings.AppearanceSettingsActivity" android:exported="false" />
        <activity android:name=".ui.settings.GeneralSettingsActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.settings.PrivacyInfoActivity" android:exported="false" />
        <activity android:name=".ui.settings.AboutActivity" android:exported="false" />

        <!-- Floating Window Engine Foreground Service -->
        <service
            android:name=".service.FloatingWindowService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating multitasking window overlay, bubble launcher, and edge sidebar" />
        </service>

        <!-- Optional Media Notification Listener for Music Metadata -->
        <service
            android:name=".service.MediaSessionMonitorService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
