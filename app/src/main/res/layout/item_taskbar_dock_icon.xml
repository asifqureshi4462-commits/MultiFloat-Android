<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="3dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:minWidth="50dp"
    android:minHeight="52dp"
    android:orientation="vertical"
    android:paddingHorizontal="4dp"
    android:paddingVertical="2dp">

    <FrameLayout
        android:id="@+id/dock_icon_tile"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_pill_chip">

        <ImageView
            android:id="@+id/iv_dock_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@string/cd_dock_restore_window"
            app:tint="@color/electric_cyan" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_dock_label"
        android:layout_width="46dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="@font/plus_jakarta_sans"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/mf_text_secondary"
        android:textSize="9sp"
        android:textStyle="bold" />

    <View
        android:id="@+id/view_dock_indicator"
        android:layout_width="14dp"
        android:layout_height="3dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_floating_bubble" />
</LinearLayout>
