<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- URL & Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="6dp">

        <ImageButton
            android:id="@+id/btn_browser_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/mf_text_primary" />

        <ImageButton
            android:id="@+id/btn_browser_forward"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Forward"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/mf_text_primary" />

        <EditText
            android:id="@+id/et_browser_url"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_card"
            android:hint="Search or enter URL"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:paddingHorizontal="10dp"
            android:singleLine="true"
            android:textColor="@color/mf_text_primary"
            android:textColorHint="@color/mf_text_muted"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/btn_browser_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Refresh"
            android:src="@drawable/ic_refresh"
            app:tint="@color/electric_cyan" />

        <ImageButton
            android:id="@+id/btn_browser_home"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Home"
            android:src="@drawable/ic_browser"
            app:tint="@color/mf_text_primary" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_browser"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progressTint="@color/electric_cyan"
        android:visibility="gone" />

    <WebView
        android:id="@+id/webview_mini"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
