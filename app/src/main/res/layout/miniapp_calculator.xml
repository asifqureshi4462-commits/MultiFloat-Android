<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Top Mode & Action Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_sci_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="Scientific"
            android:textSize="12sp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_history_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:checkable="true"
            android:text="History"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_copy_calc"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Copy result"
            android:src="@drawable/ic_copy"
            app:tint="@color/mf_cyan_text" />
    </LinearLayout>

    <!-- Display Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tv_calc_expression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono"
            android:gravity="end"
            android:maxLines="2"
            android:text="0"
            android:textColor="@color/mf_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_calc_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/jetbrains_mono"
            android:gravity="end"
            android:maxLines="1"
            android:text="0"
            android:textColor="@color/mf_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Collapsible History Panel -->
    <LinearLayout
        android:id="@+id/panel_calc_history"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Calculation History"
                android:textColor="@color/mf_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_clear_calc_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="Clear"
                android:textColor="@color/mf_error"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_calc_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- Keypad Container -->
    <LinearLayout
        android:id="@+id/panel_calc_keypad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Scientific Row 1 & 2 (collapsible) -->
        <LinearLayout
            android:id="@+id/panel_sci_keys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:orientation="horizontal">
                <Button android:id="@+id/btn_sin" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:text="sin" android:textColor="@color/mf_text_primary" android:textSize="11sp" />
                <Button android:id="@+id/btn_cos" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:text="cos" android:textColor="@color/mf_text_primary" android:textSize="11sp" />
                <Button android:id="@+id/btn_tan" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:text="tan" android:textColor="@color/mf_text_primary" android:textSize="11sp" />
                <Button android:id="@+id/btn_sqrt" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:text="√" android:textColor="@color/mf_text_primary" android:textSize="12sp" />
                <Button android:id="@+id/btn_pow" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:text="^" android:textColor="@color/mf_text_primary" android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:orientation="horizontal">
                <Button android:id="@+id/btn_log" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:text="log" android:textColor="@color/mf_text_primary" android:textSize="11sp" />
                <Button android:id="@+id/btn_ln" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:text="ln" android:textColor="@color/mf_text_primary" android:textSize="11sp" />
                <Button android:id="@+id/btn_lparen" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:text="(" android:textColor="@color/mf_text_primary" android:textSize="12sp" />
                <Button android:id="@+id/btn_rparen" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:text=")" android:textColor="@color/mf_text_primary" android:textSize="12sp" />
                <Button android:id="@+id/btn_pi" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:text="π" android:textColor="@color/mf_text_primary" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Basic 5x4 Grid (insetTop/Bottom=0dp guarantees buttons remain clickable & never clip inside floating windows) -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <Button android:id="@+id/btn_clear" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:text="C" android:textColor="@color/mf_error" android:textStyle="bold" />
            <Button android:id="@+id/btn_del" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:text="⌫" android:textColor="@color/mf_text_primary" />
            <Button android:id="@+id/btn_mod" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:text="%" android:textColor="@color/mf_text_primary" />
            <Button android:id="@+id/btn_div" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:text="÷" android:textColor="@color/mf_cyan_text" android:textSize="17sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <Button android:id="@+id/btn_7" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:text="7" android:textColor="@color/mf_text_primary" android:textSize="15sp" />
            <Button android:id="@+id/btn_8" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:text="8" android:textColor="@color/mf_text_primary" android:textSize="15sp" />
            <Button android:id="@+id/btn_9" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:text="9" android:textColor="@color/mf_text_primary" android:textSize="15sp" />
            <Button android:id="@+id/btn_mul" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:text="×" android:textColor="@color/mf_cyan_text" android:textSize="17sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <Button android:id="@+id/btn_4" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:text="4" android:textColor="@color/mf_text_primary" android:textSize="15sp" />
            <Button android:id="@+id/btn_5" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:text="5" android:textColor="@color/mf_text_primary" android:textSize="15sp" />
            <Button android:id="@+id/btn_6" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:text="6" android:textColor="@color/mf_text_primary" android:textSize="15sp" />
            <Button android:id="@+id/btn_sub" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:text="−" android:textColor="@color/mf_cyan_text" android:textSize="17sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <Button android:id="@+id/btn_1" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:text="1" android:textColor="@color/mf_text_primary" android:textSize="15sp" />
            <Button android:id="@+id/btn_2" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:text="2" android:textColor="@color/mf_text_primary" android:textSize="15sp" />
            <Button android:id="@+id/btn_3" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:text="3" android:textColor="@color/mf_text_primary" android:textSize="15sp" />
            <Button android:id="@+id/btn_add" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:text="+" android:textColor="@color/mf_cyan_text" android:textSize="17sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <Button android:id="@+id/btn_0" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:layout_weight="2" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:text="0" android:textColor="@color/mf_text_primary" android:textSize="15sp" />
            <Button android:id="@+id/btn_dot" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:text="." android:textColor="@color/mf_text_primary" android:textSize="17sp" />
            <Button android:id="@+id/btn_eq" style="@style/Widget.Material3.Button" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:text="=" android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
