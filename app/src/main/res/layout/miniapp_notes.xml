<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- List View Panel -->
    <LinearLayout
        android:id="@+id/panel_notes_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_notes_search"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_card"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="8dp"
                android:hint="Search notes..."
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="@color/mf_text_primary"
                android:textColorHint="@color/mf_text_muted"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/btn_new_note"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button_electric"
                android:contentDescription="New note"
                android:src="@drawable/ic_add"
                app:tint="@color/mf_on_accent" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_notes_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="No notes yet.\nTap + to create a quick note."
            android:textColor="@color/mf_text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_notes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Editor Panel -->
    <LinearLayout
        android:id="@+id/panel_note_editor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_note_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back to notes list"
                android:src="@drawable/ic_back"
                app:tint="@color/mf_text_primary" />

            <TextView
                android:id="@+id/tv_note_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Auto-saved"
                android:textColor="@color/mf_success"
                android:textSize="11sp" />

            <ImageButton
                android:id="@+id/btn_note_pin"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Pin note"
                android:src="@drawable/ic_star_outline"
                app:tint="@color/electric_cyan" />

            <ImageButton
                android:id="@+id/btn_note_delete"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete note"
                android:src="@drawable/ic_delete"
                app:tint="@color/mf_error" />
        </LinearLayout>

        <EditText
            android:id="@+id/et_note_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@null"
            android:hint="Note title"
            android:inputType="textCapSentences"
            android:paddingVertical="6dp"
            android:textColor="@color/mf_text_primary"
            android:textColorHint="@color/mf_text_muted"
            android:textSize="17sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/mf_divider" />

        <EditText
            android:id="@+id/et_note_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:background="@null"
            android:gravity="top|start"
            android:hint="Start typing your note..."
            android:inputType="textMultiLine|textCapSentences"
            android:textColor="@color/mf_text_primary"
            android:textColorHint="@color/mf_text_muted"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
