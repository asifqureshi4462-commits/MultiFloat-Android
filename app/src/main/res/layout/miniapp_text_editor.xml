<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_editor_filename"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_card"
            android:hint="untitled.txt"
            android:inputType="text"
            android:paddingHorizontal="10dp"
            android:singleLine="true"
            android:text="draft.txt"
            android:textColor="@color/mf_text_primary"
            android:textColorHint="@color/mf_text_muted"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/btn_editor_save"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Save file"
            android:src="@drawable/ic_save"
            app:tint="@color/electric_cyan" />

        <ImageButton
            android:id="@+id/btn_editor_copy"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Copy all"
            android:src="@drawable/ic_copy"
            app:tint="@color/mf_text_primary" />

        <ImageButton
            android:id="@+id/btn_editor_share"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Share text"
            android:src="@drawable/ic_share"
            app:tint="@color/mf_text_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_editor_stats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 words • 0 chars"
            android:textColor="@color/mf_text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btn_editor_files"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="Saved Files"
            android:textColor="@color/electric_cyan"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_editor_paste"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="Paste"
            android:textColor="@color/electric_blue"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <EditText
        android:id="@+id/et_editor_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="@drawable/bg_glass_card"
        android:fontFamily="@font/jetbrains_mono"
        android:gravity="top|start"
        android:hint="Write or paste text here..."
        android:inputType="textMultiLine"
        android:padding="12dp"
        android:textColor="@color/mf_text_primary"
        android:textColorHint="@color/mf_text_muted"
        android:textSize="13sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_saved_files"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:visibility="gone" />
</LinearLayout>
