<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <FrameLayout
        android:id="@+id/bubble_orb"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_floating_bubble"
        android:elevation="10dp">

        <ImageView
            android:id="@+id/iv_bubble_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:contentDescription="@string/cd_floating_bubble"
            android:src="@drawable/ic_multifloat_logo" />

        <TextView
            android:id="@+id/tv_bubble_badge"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_pill_chip"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/electric_cyan"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
