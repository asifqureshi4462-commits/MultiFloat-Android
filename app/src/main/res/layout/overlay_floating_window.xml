<?xml version="1.0" encoding="utf-8"?>
<com.example.ui.view.FloatingWindowFrame xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/window_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:elevation="14dp"
    android:padding="2dp">

    <LinearLayout
        android:id="@+id/window_card_inner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="5dp"
        android:orientation="vertical">

        <!-- Draggable Title Bar with Explicit Contrast Header -->
        <LinearLayout
            android:id="@+id/window_title_bar"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@color/mf_window_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp">

            <View
                android:id="@+id/view_focus_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_floating_bubble" />

            <ImageView
                android:id="@+id/iv_window_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Tool icon"
                app:tint="@color/mf_cyan_text" />

            <TextView
                android:id="@+id/tv_window_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/plus_jakarta_sans"
                android:maxLines="1"
                android:text="Window"
                android:textColor="@color/mf_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_win_opacity"
                android:layout_width="36dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_window_opacity"
                android:src="@drawable/ic_opacity"
                app:tint="@color/mf_text_secondary" />

            <ImageButton
                android:id="@+id/btn_win_minimize"
                android:layout_width="36dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_minimize_window"
                android:src="@drawable/ic_minimize"
                app:tint="@color/mf_text_primary" />

            <ImageButton
                android:id="@+id/btn_win_maximize"
                android:layout_width="36dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_maximize_window"
                android:src="@drawable/ic_maximize"
                app:tint="@color/mf_text_primary" />

            <ImageButton
                android:id="@+id/btn_win_close"
                android:layout_width="36dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_close_window"
                android:src="@drawable/ic_close"
                app:tint="@color/mf_error" />
        </LinearLayout>

        <!-- Inline Transparency Slider Toolbar -->
        <LinearLayout
            android:id="@+id/panel_win_opacity_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/mf_window_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Opacity"
                android:textColor="@color/mf_text_secondary"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/seek_win_opacity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="65"
                android:progress="55" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/mf_divider" />

        <!-- Mini-App Content Container -->
        <FrameLayout
            android:id="@+id/window_content_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Bottom Status Hint Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <TextView
                android:id="@+id/tv_win_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/win_hint_move_resize"
                android:textColor="@color/mf_text_muted"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Edge Visual Resize Handles (positioned strictly along outer frame margins so title bar dragging never collides) -->
    <FrameLayout
        android:id="@+id/resize_edge_left"
        android:layout_width="14dp"
        android:layout_height="76dp"
        android:layout_gravity="start|center_vertical"
        android:contentDescription="@string/cd_resize_edge_left">

        <View
            android:id="@+id/pill_resize_left"
            android:layout_width="4dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_resize_pill" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/resize_edge_right"
        android:layout_width="14dp"
        android:layout_height="76dp"
        android:layout_gravity="end|center_vertical"
        android:contentDescription="@string/cd_resize_edge_right">

        <View
            android:id="@+id/pill_resize_right"
            android:layout_width="4dp"
            android:layout_height="40dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/bg_resize_pill" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/resize_edge_top"
        android:layout_width="64dp"
        android:layout_height="9dp"
        android:layout_gravity="top|center_horizontal"
        android:contentDescription="@string/cd_resize_edge_top">

        <View
            android:id="@+id/pill_resize_top"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="top|center_horizontal"
            android:background="@drawable/bg_resize_pill" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/resize_edge_bottom"
        android:layout_width="76dp"
        android:layout_height="14dp"
        android:layout_gravity="bottom|center_horizontal"
        android:contentDescription="@string/cd_resize_edge_bottom">

        <View
            android:id="@+id/pill_resize_bottom"
            android:layout_width="42dp"
            android:layout_height="4dp"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@drawable/bg_resize_pill" />
    </FrameLayout>

    <!-- Corner Visual Resize Handles -->
    <FrameLayout
        android:id="@+id/resize_corner_top_left"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="top|start"
        android:contentDescription="@string/cd_resize_corner_tl">

        <ImageView
            android:id="@+id/iv_resize_tl"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="top|start"
            android:contentDescription="@null"
            android:src="@drawable/ic_resize_corner_tl"
            app:tint="@color/mf_cyan_text" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/resize_corner_top_right"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="top|end"
        android:contentDescription="@string/cd_resize_corner_tr">

        <ImageView
            android:id="@+id/iv_resize_tr"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="top|end"
            android:contentDescription="@null"
            android:src="@drawable/ic_resize_corner_tr"
            app:tint="@color/mf_cyan_text" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/resize_corner_bottom_left"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="bottom|start"
        android:contentDescription="@string/cd_resize_corner_bl">

        <ImageView
            android:id="@+id/iv_resize_bl"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="bottom|start"
            android:contentDescription="@null"
            android:src="@drawable/ic_resize_corner_bl"
            app:tint="@color/mf_cyan_text" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/resize_corner_bottom_right"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="bottom|end"
        android:contentDescription="@string/cd_resize_window">

        <ImageView
            android:id="@+id/iv_resize_handle"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="bottom|end"
            android:contentDescription="@null"
            android:src="@drawable/ic_resize_corner_br"
            app:tint="@color/mf_cyan_text" />
    </FrameLayout>
</com.example.ui.view.FloatingWindowFrame>
