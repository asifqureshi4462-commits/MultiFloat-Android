<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sidebar_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- Edge Handle Tab (Tap or Swipe Inward to Slide Out Drawer) -->
    <FrameLayout
        android:id="@+id/sidebar_handle"
        android:layout_width="26dp"
        android:layout_height="104dp"
        android:background="@drawable/bg_button_electric"
        android:clickable="true"
        android:contentDescription="@string/cd_sidebar_handle"
        android:elevation="8dp"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_sb_handle_arrow"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_left"
                app:tint="#E6FFFFFF" />

            <View
                android:layout_width="3dp"
                android:layout_height="28dp"
                android:layout_marginTop="4dp"
                android:background="#CCFFFFFF" />
        </LinearLayout>
    </FrameLayout>

    <!-- Slide-Out Apps & Mini-Apps Drawer Panel -->
    <LinearLayout
        android:id="@+id/sidebar_panel"
        android:layout_width="224dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        android:elevation="14dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <!-- Drawer Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_sb_drawer_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="@string/drawer_title"
                    android:textColor="@color/mf_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_sb_drawer_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/drawer_subtitle"
                    android:textColor="@color/mf_cyan_text"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_sb_collapse"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Collapse sidebar"
                android:src="@drawable/ic_close"
                app:tint="@color/mf_text_secondary" />
        </LinearLayout>

        <!-- Drawer Search Box -->
        <EditText
            android:id="@+id/et_sb_search"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_drawer_item"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="6dp"
            android:hint="@string/drawer_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:textColor="@color/mf_text_primary"
            android:textColorHint="@color/mf_text_muted"
            android:textSize="11sp" />

        <!-- Category Filter Tabs -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tab_sb_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="5dp"
                    android:text="@string/drawer_filter_all"
                    android:textColor="@color/mf_cyan_text"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tab_sb_apps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_pill_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="5dp"
                    android:text="@string/drawer_filter_apps"
                    android:textColor="@color/mf_text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tab_sb_productivity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_pill_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="5dp"
                    android:text="@string/drawer_filter_productivity"
                    android:textColor="@color/mf_text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tab_sb_favorites"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_pill_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="5dp"
                    android:text="@string/drawer_filter_favorites"
                    android:textColor="@color/mf_text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Scrollable Apps + Mini-Apps List -->
        <ScrollView
            android:id="@+id/scroll_sb_tools"
            android:layout_width="match_parent"
            android:layout_height="290dp"
            android:layout_marginTop="8dp"
            android:fadingEdgeLength="16dp"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/sidebar_tools_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="@color/mf_divider" />

        <!-- Quick Utility Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_sb_flashlight"
                android:layout_width="40dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Toggle flashlight"
                android:src="@drawable/ic_flashlight"
                app:tint="@color/mf_text_primary" />

            <ImageButton
                android:id="@+id/btn_sb_apps"
                android:layout_width="40dp"
                android:layout_height="38dp"
                android:layout_marginHorizontal="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_installed_apps"
                android:src="@drawable/ic_apps"
                app:tint="@color/mf_cyan_text" />

            <ImageButton
                android:id="@+id/btn_sb_dashboard"
                android:layout_width="40dp"
                android:layout_height="38dp"
                android:layout_marginHorizontal="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Open MultiFloat dashboard"
                android:src="@drawable/ic_windows"
                app:tint="@color/electric_blue" />

            <ImageButton
                android:id="@+id/btn_sb_settings"
                android:layout_width="40dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_sidebar_settings"
                android:src="@drawable/ic_settings"
                app:tint="@color/mf_text_primary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
