    <!-- Onboarding -->
    <string name="onboarding_title_1">Desktop-Style Floating Windows</string>
    <string name="onboarding_desc_1">Launch multiple draggable, resizable glassmorphic mini-apps simultaneously over any screen with smooth edge snapping.</string>
    <string name="onboarding_title_2">12 Built-In Productivity Tools</string>
    <string name="onboarding_desc_2">Scientific calculator, auto-saving notes, mini browser, QR scanner, stopwatch, to-do list, AI assistant, translator, and more.</string>
    <string name="onboarding_title_3">Intelligent Edge Sidebar</string>
    <string name="onboarding_desc_3">Access favorite tools, recent windows, flashlight, and quick settings with a single swipe from either screen edge.</string>
