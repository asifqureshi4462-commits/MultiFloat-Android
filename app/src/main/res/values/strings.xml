    <string name="perm_screen_title">System Permissions</string>
    <string name="perm_screen_subtitle">MultiFloat uses transparent, least-privilege permissions so floating windows work reliably across your device.</string>
    <string name="perm_overlay_title">Display Over Other Apps</string>
    <string name="perm_overlay_desc">Required by Android to render floating bubbles, the edge sidebar, and resizable mini-app windows above other apps.</string>
